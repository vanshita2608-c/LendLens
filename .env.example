# ==============================================================================
# LendLens Environment Configuration (.env.example)
# Copy this file to .env for local overrides. DO NOT commit actual secrets.
# ==============================================================================

# Backend & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Database Configuration
# Default: Local SQLite for lightweight instant setup
DATABASE_URL=sqlite:///./lendlens.db
# For Docker Compose / PostgreSQL production setup:
# DATABASE_URL=postgresql://lendlens_user:lendlens_pass@localhost:5432/lendlens_db

# Frontend URL & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Copilot (Optional)
# LendLens features a deterministic fallback engine; will function 100% without keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
